# .env.example
# This file serves as a template for the required environment variables for the
# AI-Powered Personalized News Aggregator.
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env` in the same directory.
# 2. Replace the placeholder values with your actual configuration values.
# 3. The `.env` file is ignored by Git (see .gitignore) to keep your secrets safe.
#    *** DO NOT COMMIT THE .env FILE TO VERSION CONTROL. ***

#-----------------------------------------------------------------------
# GENERAL APPLICATION CONFIGURATION
#-----------------------------------------------------------------------

# The environment mode for the application (e.g., development, production, test)
NODE_ENV=development


#-----------------------------------------------------------------------
# FRONTEND (React App)
#-----------------------------------------------------------------------
# Note: Variables for the React app must be prefixed with REACT_APP_

# The base URL for the backend API that the frontend will communicate with.
# In development with docker-compose, this will typically point to the backend container's exposed port.
REACT_APP_API_BASE_URL=http://localhost:5001/api


#-----------------------------------------------------------------------
# BACKEND (Python Flask API)
#-----------------------------------------------------------------------

# The entry point for the Flask application.
FLASK_APP=app.py

# The environment for Flask (development or production).
# In 'development', this enables the interactive debugger and automatic reloader.
FLASK_ENV=development

# The host the Flask app will bind to. Use '0.0.0.0' to make it accessible
# from outside the Docker container.
FLASK_RUN_HOST=0.0.0.0

# The port the Flask app will run on inside its container.
FLASK_RUN_PORT=5001

# A secret key used by Flask for securely signing session cookies and other security-related needs.
# Generate a strong, random key for production.
# You can generate one with: python -c 'import secrets; print(secrets.token_hex(24))'
FLASK_SECRET_KEY=changeme_in_production_with_a_real_secret

# A comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# In development, this should be the URL of your React app.
# For production, be specific (e.g., https://your-domain.com,https://www.your-domain.com).
CORS_ORIGINS=http://localhost:3000


#-----------------------------------------------------------------------
# DATABASE (PostgreSQL)
#-----------------------------------------------------------------------
# These variables are used by the backend service and docker-compose to configure the database.

# The hostname of the database server.
# When using docker-compose, this should be the name of the database service (e.g., 'db').
POSTGRES_HOST=db

# The port for the PostgreSQL database.
POSTGRES_PORT=5432

# The name of the database to connect to.
POSTGRES_DB=news_aggregator

# The username for the database connection.
POSTGRES_USER=news_user

# The password for the database connection.
# Use a strong, randomly generated password in production.
POSTGRES_PASSWORD=strong_password_changeme


#-----------------------------------------------------------------------
# EXTERNAL SERVICES & APIs
#-----------------------------------------------------------------------

# API Key for the news source (e.g., NewsAPI.org, GNews.io).
# This is required to fetch news articles.
NEWS_API_KEY=your_news_api_key_here

# Base URL for the news source API.
NEWS_API_BASE_URL=https://newsapi.org/v2

# Specifies the sentiment analysis model to use.
# Options: 'local_vader' (built-in, fast), 'huggingface_distilbert' (more accurate, requires more setup).
SENTIMENT_ANALYSIS_MODEL=local_vader


#-----------------------------------------------------------------------
# INTERCONNECTED MICROSERVICE CONFIGURATION
#-----------------------------------------------------------------------
# URLs for other services in the larger system.
# These allow the news aggregator to interact with other parts of the ecosystem.

# URL for the Personal Recipe Book API to link food-related articles.
RECIPE_BOOK_API_URL=http://localhost:8081/api/recipes

# URL for the Real-time Markdown Previewer service, potentially for rendering user comments or notes.
MARKDOWN_PREVIEWER_SERVICE_URL=http://localhost:8082/api/render

# URL for a shared User Authentication/Profile service.
# (Assuming a central service handles user data across all projects).
AUTH_SERVICE_URL=http://localhost:9000/api/auth